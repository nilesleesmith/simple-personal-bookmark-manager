<!DOCTYPE html>
<html>
  <head>
    <title>Edit Bookmark - Personal Bookmark Manager</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <h1>Edit Bookmark</h1>
    <% if (bookmarkMessage.length > 0) { %>
      <p><%= bookmarkMessage[0] %></p>
    <% } %>
    <form action="/bookmarks/<%= bookmark._id %>/edit" method="POST">
      <p><label>Title <input type="text" name="title" value="<%= bookmark.title %>"></label></p>
      <p><label>URL <input type="text" name="url" value="<%= bookmark.url %>"></label></p>
      <button type="submit">Save Changes</button>
    </form>
    <p><a href="/profile">Cancel</a></p>
  </body>
</html>
